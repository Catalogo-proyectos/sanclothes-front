# ============================================================================
# SANCLOTHES STOREFRONT — variables de entorno
# Copiar a `.env` y ajustar. `.env` está en .gitignore (nunca se commitea).
# docker-compose.yml lee este archivo para el build y el runtime.
# ============================================================================

# ===== BACKEND API =====
NEXT_PUBLIC_API_URL=http://localhost:5014/api
NEXT_PUBLIC_HEALTH_URL=http://localhost:5014/health

# ===== MEDIA (imágenes de catálogo) =====
# Host vigente donde se sirven las fotos. Dev con docker = MinIO en 5012.
# Si MinIO no está configurado, el backend cae a http://localhost:5014/uploads.
# Producción: https://api.santclothes.com.py
NEXT_PUBLIC_MEDIA_ORIGIN=http://localhost:5012

# ===== FRONTEND =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENV=development

# ===== FEATURES =====
NEXT_PUBLIC_FEATURE_LOYALTY=true
NEXT_PUBLIC_FEATURE_REFERRALS=true
NEXT_PUBLIC_FEATURE_SIZE_FINDER=true
NEXT_PUBLIC_FEATURE_GIFT_CARDS=true

# ===== LOGGING & SECURITY =====
NEXT_PUBLIC_LOG_LEVEL=debug
NEXT_PUBLIC_JWT_STORAGE_KEY=sant_auth_token

# ===== CLOUDFLARE TURNSTILE =====
# Solo aplica a POST /api/checkout/verify-email (STOREFRONT-INTEGRATION §2.3).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ===== GOOGLE IDENTITY SERVICES =====
# Este es el CLIENT ID público (viaja al navegador; no es secreto).
# El GOOGLE_CLIENT_SECRET es privado y lo usa SOLO el backend:
# se configura en el .env del repo del backend, NUNCA acá.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=63719750890-5t5oascpaq5sp457v4bru4tttjiaign2.apps.googleusercontent.com

# ===== ORIGIN DE API (opcional) =====
# Si se prefiere, se puede apuntar al origin y el front arma /api solo.
# NEXT_PUBLIC_SANTCLOTHES_API_ORIGIN=https://api.santclothes.com.py

# ===== DOCKER (solo docker-compose) =====
# Puerto del host donde se publica el contenedor.
# HTTP_PORT=3000
